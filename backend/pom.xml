<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jade</groupId>
    <artifactId>jade-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Jade Platform Parent</name>
    <description>Jade - 温润如玉的 Java 全栈底座</description>

    <modules>
        <module>jade-dependencies</module>
        <module>jade-common</module>
        <module>jade-web</module>
        <module>jade-security</module>
        <module>jade-log</module>
        <module>jade-oss</module>
        <module>jade-codegen</module>
        <module>jade-spring-bridge</module>
        <module>jade-admin</module>
        <module>jade-wiki</module>
        <module>jade-mail</module>
        <module>jade-ldap-client</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Jade 版本 -->
        <jade.version>1.0.0-SNAPSHOT</jade.version>

        <!-- 第三方版本 -->
        <quarkus.platform.version>3.39.1</quarkus.platform.version>
        <quarkiverse-mcp.version>2.0.4</quarkiverse-mcp.version>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>

        <lombok.version>1.18.38</lombok.version>
        <mapstruct.version>1.6.2</mapstruct.version>
        <jjwt.version>0.12.6</jjwt.version>
        <hutool.version>5.8.32</hutool.version>

        <!-- 插件版本 -->
        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.0</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus 官方 BOM -->
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Jade 内部模块版本（供 jade-* 子模块继承） -->
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-common</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-web</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-security</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-mcp</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-log</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-oss</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-codegen</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-mail</artifactId>
                <version>${jade.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jade</groupId>
                <artifactId>jade-ldap-client</artifactId>
                <version>${jade.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <release>17</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>io.quarkus</groupId>
                                <artifactId>quarkus-arc-deployment</artifactId>
                                <version>${quarkus.platform.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
